# Firebase project config (from Firebase Console > Project settings > General > Your apps > SDK setup and config)
# Copy this file to `.env` and fill in the values. These are client identifiers, not
# secrets — access is controlled by Firestore/Auth security rules, not by hiding these values.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
